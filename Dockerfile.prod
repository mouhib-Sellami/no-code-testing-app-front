FROM node:20 AS build

WORKDIR /app

COPY package*.json ./

# COPY .env ./.env

COPY .env.production ./.env.production

RUN npm install

COPY . .

RUN npm run build

FROM nginx:latest

COPY --from=build /app/dist /usr/share/nginx/html
COPY conf/nginx.conf /etc/nginx/nginx.conf

EXPOSE 88

CMD ["nginx", "-g", "daemon off;"]